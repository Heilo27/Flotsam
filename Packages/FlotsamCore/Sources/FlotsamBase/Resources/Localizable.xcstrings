    "error.LIB-OS-001" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't paste into that app. The item is on your clipboard; press ⌘V." } } }
    },
    "error.ORG-LIM-001" : {
