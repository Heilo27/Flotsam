    },
    "error.CAP-PRM-001" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS is blocking Flotsam from reading copied items. Allow Flotsam under Paste from Other Apps in System Settings." } } }
    },
    "error.LIB-DAT-001" : {
